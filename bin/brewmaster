#!/usr/bin/env bash
[ -z "${BASH_VERSION:-}" ] && exec bash "$0" "$@"
set -euo pipefail

BREWMASTER_VERSION="0.5.0"

# Global configuration (overridden by CLI flags below).
LEVEL="patch"        # patch | minor | major  (exact category; exclusive by default)
LEVEL_EXPLICIT=false # becomes true once a level flag is given (guards conflicts)
OR_LOWER=false       # if true: inclusive (e.g. minor => minor+patch; major => all)
ALLOW_DATE=false     # treat date-style versions (YYYY.MM.DD) as semver-like
DRY_RUN=false
ONLY_FORMULAE=false
ONLY_CASKS=false
VERBOSE=false
SNAP_LABEL=""
SNAP_FORCE=false
CHECK_DEPS=false
RISK_THRESHOLD=7
YES_FLAG=false
DEPS_SUBCMD=""
PROFILE_NAME=""
INTERACTIVE=false
PROFILE_SUBCMD=""
PROFILE_INCLUDE=()
PROFILE_EXCLUDE=()
PROFILE_REQUIRE_CONFIRM=false
PROFILE_MAX_RISK=10
PROFILE_LEVEL=""
CLEANUP_FORCE=false

usage() {
  cat <<'USAGE'
Usage: brewmaster [upgrade] [packages...] [options]
       brewmaster snapshot <save|list|diff|restore|delete> [ref] [options]
       brewmaster deps show [package]
       brewmaster profile <list|create|edit|diff|validate> [args]
       brewmaster cleanup [--dry-run|--interactive|--force]
       brewmaster why <package>
       brewmaster bloat

Commands:
  upgrade                    Selective upgrade by semver bump level (default).
                             Pass package names to limit the upgrade to those:
                             e.g. brewmaster upgrade git node --minor
  snapshot save              Save current Homebrew state to a snapshot.
  snapshot list              List all snapshots.
  snapshot diff [INDEX|PATH] Show packages changed since a snapshot.
  snapshot restore [INDEX|PATH]  Restore packages to a snapshot state.
  snapshot delete [INDEX|PATH]   Delete a snapshot.
  deps show [package]        Show dependency risk for one package, or list all
                             outdated packages sorted by risk score.
  profile list               List configured profiles.
  profile create             Interactive wizard to add a new profile.
  profile edit [name]        Open profiles.toml in $EDITOR.
  profile diff <a> <b>       Compare include lists between two profiles.
  profile validate           Check profiles.toml for errors.
  cleanup                    Report orphan/stale/pinned-old formulae (read-only by default).
                             --interactive selects packages to remove (fzf);
                             --force auto-removes orphans with score >= 7.
  why <package>              Explain why a formula is installed (dependents,
                             install date, last-access heuristic).
  bloat                      Summary of installed package counts and estimated
                             disk reclaim from cleanup candidates.

Level (mutually exclusive; default: patch):
  --patch                    Apply patch bumps only (default).
  --minor                    Apply minor bumps only.
  --major                    Apply major bumps only.
  --level=patch|minor|major  Alias for the level flags (also: --level minor).

Options (upgrade):
  --or-lower                 Make it inclusive (e.g. --minor => minor+patch; --major => all).
  --allow-date               Treat date versions (YYYY.MM.DD / YYYY-MM-DD...) as semver-like. Default: false.
  -n, --dry-run              Show the plan without executing.
  --formulae                 Formulae only (skip casks).
  --casks                    Casks only (skip formulae).
  --check-deps               Risk-score each candidate; skip HIGH-risk, warn on MEDIUM.
  --risk-threshold=N         HIGH-risk cutoff (default: 7; range 0-10).
  --yes, -y                  Auto-confirm MEDIUM-risk packages (no prompt).
  --profile=NAME             Filter/level from a named profile in profiles.toml.
  --interactive, -i          fzf multi-select among upgrade candidates (requires fzf).

Options (snapshot):
  --label=TEXT               Label for 'snapshot save'.
  --force                    Skip confirmation for 'snapshot delete'.
  -n, --dry-run              Show plan without executing for 'snapshot restore'.

Options (cleanup):
  -n, --dry-run              Read-only report (also the default with no flags).
  --interactive, -i          fzf multi-select packages to remove (requires fzf).
  --force                    Auto-remove orphans with score >= 7.

Options (general):
  -v, --verbose              More detailed output.
  -V, --version              Print version and exit.
  -h, --help                 Show this help.

Notes:
- Pre-release (-rc.1) and +build metadata are ignored during comparison (only M.m.p).
- Date/timestamp versions are skipped unless --allow-date is used.
- Snapshots stored in: ~/.local/share/brewmaster/snapshots/ (XDG_DATA_HOME respected).
- Risk score 0-10: HIGH >= threshold (default 7), MEDIUM 4-6, LOW 0-3.
- Profiles read from: ~/.config/brewmaster/profiles.toml (XDG_CONFIG_HOME respected).
USAGE
}

# logv — print a debug line to stderr when VERBOSE is true.
logv() { $VERBOSE && echo "[v] $*" >&2 || true; }

# set_level — select the bump level, rejecting conflicting level flags.
set_level() {
  $LEVEL_EXPLICIT && { echo "Error: level specified more than once." >&2; exit 1; }
  LEVEL="$1"; LEVEL_EXPLICIT=true
}

# --- Subcommand (defaults to "upgrade") ---
COMMAND="upgrade"
SNAPSHOT_SUBCMD=""
if [[ $# -gt 0 && "$1" != -* ]]; then
  case "$1" in
    upgrade)  COMMAND="$1"; shift ;;
    snapshot) COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                SNAPSHOT_SUBCMD="$1"; shift
              fi ;;
    deps)     COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                DEPS_SUBCMD="$1"; shift
              fi ;;
    profile)  COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                PROFILE_SUBCMD="$1"; shift
              fi ;;
    cleanup|why|bloat) COMMAND="$1"; shift ;;
    *) echo "Unknown command: $1" >&2; usage; exit 1 ;;
  esac
fi

# --- Argument parsing ---
PACKAGES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --patch)         set_level patch ;;
    --minor)         set_level minor ;;
    --major)         set_level major ;;
    --level=*)       set_level "${1#*=}" ;;
    --level)         shift; set_level "${1-}" ;;
    --or-lower)      OR_LOWER=true ;;
    --allow-date)    ALLOW_DATE=true ;;
    -n|--dry-run)    DRY_RUN=true ;;
    --formulae)      ONLY_FORMULAE=true ;;
    --casks)         ONLY_CASKS=true ;;
    --label=*)       SNAP_LABEL="${1#*=}" ;;
    --label)         shift; SNAP_LABEL="${1-}" ;;
    --force)             SNAP_FORCE=true; CLEANUP_FORCE=true ;;
    --check-deps)        CHECK_DEPS=true ;;
    --risk-threshold=*)  RISK_THRESHOLD="${1#*=}" ;;
    --risk-threshold)    shift; RISK_THRESHOLD="${1-}" ;;
    --yes|-y)            YES_FLAG=true ;;
    --profile=*)         PROFILE_NAME="${1#*=}" ;;
    --profile)           shift; PROFILE_NAME="${1-}" ;;
    --interactive|-i)    INTERACTIVE=true ;;
    -v|--verbose)        VERBOSE=true ;;
    -V|--version)    echo "brewmaster ${BREWMASTER_VERSION}"; exit 0 ;;
    -h|--help)       usage; exit 0 ;;
    -*) echo "Unknown argument: $1" >&2; usage; exit 1 ;;
    *)  PACKAGES+=("$1") ;;   # positional = package name to target
  esac
  shift
done

case "$LEVEL" in
  patch|minor|major) ;;
  *) echo "Error: invalid --level '$LEVEL' (expected patch|minor|major)." >&2; exit 1 ;;
esac

if $ONLY_FORMULAE && $ONLY_CASKS; then
  echo "Error: --formulae and --casks are mutually exclusive." >&2
  exit 1
fi

# --- Locate and source library modules (symlink-safe for Homebrew layout) ---
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$src")" && pwd)"
LIB_DIR="${BREWMASTER_LIB:-$SCRIPT_DIR/../lib/brewmaster}"

source "$LIB_DIR/core/semver.sh"
source "$LIB_DIR/core/outdated.sh"
source "$LIB_DIR/core/upgrade.sh"
source "$LIB_DIR/snapshot.sh"
source "$LIB_DIR/depgraph.sh"
source "$LIB_DIR/profile.sh"
source "$LIB_DIR/cleanup.sh"

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME" || exit 1
  [[ -n "$PROFILE_LEVEL" ]] && ! $LEVEL_EXPLICIT && LEVEL="$PROFILE_LEVEL"
fi

case "$COMMAND" in
  upgrade) run_upgrade ;;
  snapshot)
    case "$SNAPSHOT_SUBCMD" in
      save)    snapshot_save "${SNAP_LABEL:-}" ;;
      list)    snapshot_list ;;
      diff)    snapshot_diff "${PACKAGES[0]:-}" ;;
      restore) snapshot_restore "${PACKAGES[0]:-}" ;;
      delete)  snapshot_delete "${PACKAGES[0]:-}" ;;
      "")      echo "Usage: brewmaster snapshot <save|list|diff|restore|delete>" >&2; exit 1 ;;
      *)       echo "Unknown snapshot subcommand: $SNAPSHOT_SUBCMD" >&2; exit 1 ;;
    esac ;;
  deps)
    case "$DEPS_SUBCMD" in
      show)
        depgraph_build
        if [[ -n "${PACKAGES[0]:-}" ]]; then
          depgraph_report "${PACKAGES[0]}"
        else
          depgraph_list_risky
        fi ;;
      "") echo "Usage: brewmaster deps <show> [package]" >&2; exit 1 ;;
      *)  echo "Unknown deps subcommand: $DEPS_SUBCMD" >&2; exit 1 ;;
    esac ;;
  profile)
    case "$PROFILE_SUBCMD" in
      list)     profile_list ;;
      create)   profile_create ;;
      edit)     profile_edit "${PACKAGES[0]:-}" ;;
      diff)     profile_diff "${PACKAGES[0]:-}" "${PACKAGES[1]:-}" ;;
      validate) profile_validate ;;
      "")       echo "Usage: brewmaster profile <list|create|edit|diff|validate>" >&2; exit 1 ;;
      *)        echo "Unknown profile subcommand: $PROFILE_SUBCMD" >&2; exit 1 ;;
    esac ;;
  cleanup) cleanup_main ;;
  why)
    if [[ -z "${PACKAGES[0]:-}" ]]; then
      echo "Usage: brewmaster why <package>" >&2
      exit 1
    fi
    depgraph_build
    _cleanup_build
    why "${PACKAGES[0]}" ;;
  bloat) cleanup_bloat ;;
esac
