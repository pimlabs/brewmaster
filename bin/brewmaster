#!/usr/bin/env bash
[ -z "${BASH_VERSION:-}" ] && exec bash "$0" "$@"
set -euo pipefail

BREWMASTER_VERSION="0.11.0"
BUILD_DATE="2026-08-11"

# --- Locate and source library modules (symlink-safe for Homebrew layout) ---
# Resolved early (before usage()/help-related functions are defined or can be
# called) because -h/--help and the unknown-command error path both call
# usage() before argument parsing runs, and usage() depends on help_data.sh
# and (for colorized headers/command names) on ui_color_init having run.
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$src")" && pwd)"
LIB_DIR="${BREWMASTER_LIB:-$SCRIPT_DIR/../lib/brewmaster}"

source "$LIB_DIR/core/help_data.sh"
source "$LIB_DIR/core/ui.sh"
ui_color_init

# Global configuration (overridden by CLI flags below).
LEVEL="patch"        # patch | minor | major  (exact category; exclusive by default)
LEVEL_EXPLICIT=false # becomes true once a level flag is given (guards conflicts)
OR_LOWER=false       # if true: inclusive (e.g. minor => minor+patch; major => all)
ALLOW_DATE=false     # treat date-style versions (YYYY.MM.DD) as semver-like
DRY_RUN=false
ONLY_FORMULAE=false
ONLY_CASKS=false
VERBOSE=false
SNAP_LABEL=""
SNAP_FORCE=false
CHECK_DEPS=false
RISK_THRESHOLD=7
YES_FLAG=false
DEPS_SUBCMD=""
PROFILE_NAME=""
INTERACTIVE=false
PROFILE_SUBCMD=""
PROFILE_INCLUDE=()
PROFILE_EXCLUDE=()
PROFILE_REQUIRE_CONFIRM=false
PROFILE_MAX_RISK=10
PROFILE_LEVEL=""
CLEANUP_FORCE=false
AUDIT_PACKAGE=""
AUDIT_ACTION=""
AUDIT_SINCE=""
AUDIT_FORMAT="table"
HELP_TARGET=""

# _help_style_vars — set B/R/U/UR to tput sequences, or "" when styling
# should be suppressed (non-TTY, NO_COLOR set, or no tput available).
# Dim/muted styling is not set here — _help_style_desc uses ui.sh's
# COLOR_MUTED (set by ui_color_init, sourced early alongside this) instead,
# since both are the same `tput dim` sequence and don't need two copies.
# Args:   none
# Stdout: none (sets globals B R U UR)
# Return: 0
_help_style_vars() {
  B="" R="" U="" UR=""
  [ -t 1 ] || return 0
  [ -n "${NO_COLOR:-}" ] && return 0
  command -v tput >/dev/null 2>&1 || return 0
  B="$(tput bold 2>/dev/null || true)"
  R="$(tput sgr0 2>/dev/null || true)"
  U="$(tput smul 2>/dev/null || true)"
  UR="$(tput rmul 2>/dev/null || true)"
}

# _help_style_name — bold+color a definition-line name-token (using
# ui.sh's COLOR_COMMAND, decorative not semantic), underlining any
# <...>/[...] placeholder group or a trailing =NAME|TEXT|N|ACTION metavar
# without adding color to the underlined portion.
# Args:   $1 name-token text
# Stdout: styled name-token
# Return: 0
_help_style_name() {
  local name="$1" pre ph post styled_post
  if [[ "$name" =~ ^(.*)(\<[^\>]+\>)(.*)$ ]] || [[ "$name" =~ ^(.*)(\[[^]]+\])(.*)$ ]]; then
    pre="${BASH_REMATCH[1]}"
    ph="${BASH_REMATCH[2]}"
    post="${BASH_REMATCH[3]}"
    styled_post=""
    [ -n "$post" ] && styled_post="${B}${COLOR_COMMAND}${post}${R}"
    printf '%s%s%s%s%s' "$(_help_style_name "$pre")" "$U" "$ph" "$UR" "$styled_post"
    return 0
  fi
  if [[ "$name" =~ ^(.*=)(NAME|TEXT|N|ACTION)$ ]]; then
    printf '%s%s%s%s' "${B}${COLOR_COMMAND}${BASH_REMATCH[1]}${R}" "$U" "${BASH_REMATCH[2]}" "$UR"
    return 0
  fi
  [ -n "$name" ] && printf '%s%s%s' "${B}${COLOR_COMMAND}" "$name" "$R"
  return 0
}

# _help_style_desc — dim (ui.sh's COLOR_MUTED) narrow secondary-annotation
# parentheticals ("(default...)", "(also: ...)", "(requires fzf)") within
# a description.
# Args:   $1 description text
# Stdout: styled description
# Return: 0
_help_style_desc() {
  local desc="$1" out="" m
  while [[ "$desc" =~ \((default[^\)]*|also:[^\)]*|requires\ fzf)\) ]]; do
    m="${BASH_REMATCH[0]}"
    out="${out}${desc%%"$m"*}${COLOR_MUTED}${m}${COLOR_RESET}"
    desc="${desc#*"$m"}"
  done
  printf '%s%s' "$out" "$desc"
}

# _help_version_line — print "brewmaster <version>" as a banner line
# before the reference body, styled like a section header (bold+colored).
# Shared by usage() and help_command() so both show it identically.
# Args:   none
# Stdout: version line, then a blank line
# Return: 0
_help_version_line() {
  printf '%s%sbrewmaster %s%s\n\n' "$B" "$COLOR_HEADER" "$BREWMASTER_VERSION" "$R"
}

# usage — print the --help reference, with bold/underline styling plus
# COLOR_HEADER/COLOR_COMMAND/COLOR_MUTED coloring, applied when stdout is
# a TTY (suppressed for NO_COLOR, non-TTY, or no tput).
# Args:   none
# Stdout: help text
# Return: 0
usage() {
  _help_style_vars
  _help_version_line
  local line
  while IFS= read -r line; do
    _help_render_line "$line"
  done < <(_help_source_text)
}

# _help_render_line — style a single line of _help_source_text() output the
# way usage() always has (bold+colored caps-header, bold+colored+underlined
# name-tokens, muted parentheticals). Shared by usage() and help_command()
# so both renderers apply identical styling from one code path.
# Args:   $1 raw help-reference line
# Stdout: styled line (uses globals B/R/U/UR from _help_style_vars, and
#         COLOR_HEADER/COLOR_COMMAND/COLOR_MUTED/COLOR_RESET from
#         ui_color_init, both already run by the time this is called)
# Return: 0
_help_render_line() {
  local line="$1"
  case "$line" in
    "")
      printf '\n' ;;
    "Usage:"*)
      printf '%sUsage:%s%s\n' "$B" "$R" "${line#Usage:}" ;;
    "Notes:")
      printf '%sNotes:%s\n' "$B" "$R" ;;
    *)
      if [[ "$line" =~ ^([A-Z][A-Z\ \&]*)(.*)$ ]] && [ "${#BASH_REMATCH[1]}" -ge 2 ]; then
        printf '%s%s%s%s%s%s\n' "$B" "$COLOR_HEADER" "$U" "${BASH_REMATCH[1]}" "$R" "${BASH_REMATCH[2]}"
      elif [[ "$line" =~ ^(\ \ |\ \ \ \ )([^\ ]+(\ [^\ ]+)*)(\ \ +)(.*)$ ]]; then
        printf '%s%s%s%s\n' "${BASH_REMATCH[1]}" "$(_help_style_name "${BASH_REMATCH[2]}")" "${BASH_REMATCH[4]}" "$(_help_style_desc "${BASH_REMATCH[5]}")"
      elif [[ "$line" =~ ^(\ \ )([^\ ].*:)$ ]]; then
        printf '%s%s%s%s\n' "${BASH_REMATCH[1]}" "$B" "${BASH_REMATCH[2]}" "$R"
      else
        printf '%s\n' "$line"
      fi
      ;;
  esac
}

# help_command — print the reference block for a single command's group
# (`brewmaster help <command>`), sliced from the same _help_source_text()
# that drives usage(), styled through the same helpers. A group that
# covers several command tokens (e.g. SNAPSHOT & ROLLBACK) is printed in
# full regardless of which of its tokens was requested.
# Args:   $1 command name (upgrade|snapshot|deps|profile|cleanup|why|bloat|log|report)
# Stdout: the matching group's block, styled; nothing on an unknown command
# Return: 0 on a known command, 1 (with a stderr message) on an unknown one
help_command() {
  local target="$1" group="" line hdr in_block=false found=false
  case "$target" in
    upgrade)         group="UPGRADE" ;;
    deps)             group="DEPENDENCY RISK" ;;
    snapshot)         group="SNAPSHOT & ROLLBACK" ;;
    profile)          group="PROFILES" ;;
    cleanup|why|bloat) group="CLEANUP & INTENT" ;;
    log|report)       group="AUDIT LOG & REPORTS" ;;
    *)
      echo "Unknown command: $target" >&2
      return 1
      ;;
  esac

  _help_style_vars
  while IFS= read -r line; do
    if [[ "$line" =~ ^([A-Z][A-Z\ \&]*)(.*)$ ]] && [ "${#BASH_REMATCH[1]}" -ge 2 ]; then
      hdr="${BASH_REMATCH[1]% }"
      if $in_block; then
        break
      elif [ "$hdr" = "$group" ]; then
        in_block=true
        found=true
        _help_version_line
      else
        continue
      fi
    fi
    $in_block && _help_render_line "$line"
  done < <(_help_source_text)

  if ! $found; then
    echo "Unknown command: $target" >&2
    return 1
  fi
  return 0
}

# logv — print a debug line to stderr when VERBOSE is true.
logv() {
  $VERBOSE || return 0
  echo "[v] $*" >&2 || true
}

# set_level — select the bump level, rejecting conflicting level flags.
set_level() {
  $LEVEL_EXPLICIT && { echo "Error: level specified more than once." >&2; exit 1; }
  LEVEL="$1"; LEVEL_EXPLICIT=true
}

# --- Subcommand (defaults to "upgrade") ---
COMMAND="upgrade"
SNAPSHOT_SUBCMD=""
if [[ $# -gt 0 && "$1" != -* ]]; then
  case "$1" in
    upgrade)  COMMAND="$1"; shift ;;
    snapshot) COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                SNAPSHOT_SUBCMD="$1"; shift
              fi ;;
    deps)     COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                DEPS_SUBCMD="$1"; shift
              fi ;;
    profile)  COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                PROFILE_SUBCMD="$1"; shift
              fi ;;
    cleanup|why|bloat|log|report) COMMAND="$1"; shift ;;
    help)     COMMAND="$1"; shift
              if [[ $# -gt 0 && "$1" != -* ]]; then
                HELP_TARGET="$1"; shift
              fi ;;
    *) echo "Unknown command: $1" >&2; usage; exit 1 ;;
  esac
fi

# --- Argument parsing ---
PACKAGES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --patch)         set_level patch ;;
    --minor)         set_level minor ;;
    --major)         set_level major ;;
    --level=*)       set_level "${1#*=}" ;;
    --level)         shift; set_level "${1-}" ;;
    --or-lower)      OR_LOWER=true ;;
    --allow-date)    ALLOW_DATE=true ;;
    -n|--dry-run)    DRY_RUN=true ;;
    --formulae)      ONLY_FORMULAE=true ;;
    --casks)         ONLY_CASKS=true ;;
    --label=*)       SNAP_LABEL="${1#*=}" ;;
    --label)         shift; SNAP_LABEL="${1-}" ;;
    --force)             SNAP_FORCE=true; CLEANUP_FORCE=true ;;
    --check-deps)        CHECK_DEPS=true ;;
    --risk-threshold=*)  RISK_THRESHOLD="${1#*=}" ;;
    --risk-threshold)    shift; RISK_THRESHOLD="${1-}" ;;
    --yes|-y)            YES_FLAG=true ;;
    --profile=*)         PROFILE_NAME="${1#*=}" ;;
    --profile)           shift; PROFILE_NAME="${1-}" ;;
    --interactive|-i)    INTERACTIVE=true ;;
    --package=*)         AUDIT_PACKAGE="${1#*=}" ;;
    --package)           shift; AUDIT_PACKAGE="${1-}" ;;
    --action=*)          AUDIT_ACTION="${1#*=}" ;;
    --action)            shift; AUDIT_ACTION="${1-}" ;;
    --since=*)           AUDIT_SINCE="${1#*=}" ;;
    --since)             shift; AUDIT_SINCE="${1-}" ;;
    --format=*)          AUDIT_FORMAT="${1#*=}" ;;
    --format)            shift; AUDIT_FORMAT="${1-}" ;;
    -v|--verbose)        VERBOSE=true ;;
    -V|--version)    echo "brewmaster ${BREWMASTER_VERSION} (built ${BUILD_DATE})"; exit 0 ;;
    -h|--help)       usage; exit 0 ;;
    -*) echo "Unknown argument: $1" >&2; usage; exit 1 ;;
    *)  PACKAGES+=("$1") ;;   # positional = package name to target
  esac
  shift
done

case "$LEVEL" in
  patch|minor|major) ;;
  *) echo "Error: invalid --level '$LEVEL' (expected patch|minor|major)." >&2; exit 1 ;;
esac

if $ONLY_FORMULAE && $ONLY_CASKS; then
  echo "Error: --formulae and --casks are mutually exclusive." >&2
  exit 1
fi

source "$LIB_DIR/core/semver.sh"
source "$LIB_DIR/core/outdated.sh"
source "$LIB_DIR/upgrade.sh"
source "$LIB_DIR/audit.sh"
source "$LIB_DIR/snapshot.sh"
source "$LIB_DIR/depgraph.sh"
source "$LIB_DIR/profile.sh"
source "$LIB_DIR/cleanup.sh"

if [[ -n "$PROFILE_NAME" ]]; then
  profile_load "$PROFILE_NAME" || exit 1
  [[ -n "$PROFILE_LEVEL" ]] && ! $LEVEL_EXPLICIT && LEVEL="$PROFILE_LEVEL"
fi

case "$COMMAND" in
  upgrade) run_upgrade ;;
  snapshot)
    case "$SNAPSHOT_SUBCMD" in
      save)    snapshot_save "${SNAP_LABEL:-}" ;;
      list)    snapshot_list ;;
      diff)    snapshot_diff "${PACKAGES[0]:-}" ;;
      restore) snapshot_restore "${PACKAGES[0]:-}" ;;
      delete)  snapshot_delete "${PACKAGES[0]:-}" ;;
      "")      echo "Usage: brewmaster snapshot <save|list|diff|restore|delete>" >&2; exit 1 ;;
      *)       echo "Unknown snapshot subcommand: $SNAPSHOT_SUBCMD" >&2; exit 1 ;;
    esac ;;
  deps)
    case "$DEPS_SUBCMD" in
      show)
        depgraph_build
        if [[ -n "${PACKAGES[0]:-}" ]]; then
          depgraph_report "${PACKAGES[0]}"
        else
          depgraph_list_risky
        fi ;;
      "") echo "Usage: brewmaster deps <show> [package]" >&2; exit 1 ;;
      *)  echo "Unknown deps subcommand: $DEPS_SUBCMD" >&2; exit 1 ;;
    esac ;;
  profile)
    case "$PROFILE_SUBCMD" in
      list)     profile_list ;;
      create)   profile_create ;;
      edit)     profile_edit "${PACKAGES[0]:-}" ;;
      diff)     profile_diff "${PACKAGES[0]:-}" "${PACKAGES[1]:-}" ;;
      validate) profile_validate ;;
      "")       echo "Usage: brewmaster profile <list|create|edit|diff|validate>" >&2; exit 1 ;;
      *)        echo "Unknown profile subcommand: $PROFILE_SUBCMD" >&2; exit 1 ;;
    esac ;;
  cleanup) cleanup_main ;;
  why)
    if [[ -z "${PACKAGES[0]:-}" ]]; then
      echo "Usage: brewmaster why <package>" >&2
      exit 1
    fi
    depgraph_build
    _cleanup_build
    _cleanup_cellar_root
    why "${PACKAGES[0]}" ;;
  bloat) cleanup_bloat ;;
  log) audit_query ;;
  report) audit_report ;;
  help)
    if [[ -n "$HELP_TARGET" ]]; then
      help_command "$HELP_TARGET" || exit 1
    else
      usage
    fi ;;
esac
